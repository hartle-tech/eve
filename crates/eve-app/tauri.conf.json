{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "eve",
  "version": "0.1.0",
  "identifier": "tech.hartle.eve",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "windows": [
      {
        "title": "eve",
        "width": 1180,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "macOSPrivateApi": true,
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "targets": [
      "app"
    ]
  }
}
